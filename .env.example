# Copie para .env e ajuste. O carregador lê APS_DSN; o docker-compose lê as demais.
APS_DSN=postgresql://aps:aps@localhost:5432/aps_recife
POSTGRES_USER=aps
POSTGRES_PASSWORD=aps
POSTGRES_DB=aps_recife
